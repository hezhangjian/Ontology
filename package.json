{
  "name": "ontology",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "dev:all": "concurrently --kill-others-on-fail --names frontend,backend --prefix-colors cyan,magenta \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "dev:backend": "mvn spring-boot:run",
    "dev:frontend": "vite",
    "preview": "vite preview",
    "serve": "pnpm run build && mvn -Pportal clean package && java -jar target/ontology.jar --server.address=0.0.0.0"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@xyflow/react": "^12.10.0",
    "echarts": "^6.0.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.1.5"
  }
}
