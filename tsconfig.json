{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "paths": {
      "@/*": ["./portal/*"]
    },
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client"]
  },
  "include": ["portal/**/*.ts", "portal/**/*.tsx"]
}
